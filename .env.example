# === Обязательные ===
BOT_TOKEN=1234567890:AAA...           # токен от @BotFather
OPENROUTER_KEY=sk-or-v1-...           # ключ openrouter.ai
ADMIN_IDS=123456789                   # твой Telegram ID (можно несколько через запятую)

# === Провайдеры моделей (пусто = провайдер выключен) ===
FEATHERLESS_KEY=
FREETHEAI_KEY=
ECHOGATE_KEY=                         # нужен для /selfedit

# === Распознавание речи (Mistral) ===
MISTRAL_KEY=

# === Платежи рублями (Platega). Пусто = оплата рублями выключена ===
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=

# === BotoHub (реклама + обязательная подписка). Пусто = выключено ===
BOTOHUB_TOKEN=
BOTOHUB_OP_TOKEN=

# === Хостинг play2go / Pterodactyl ===
# ВАЖНО: PANEL_API_KEY НЕ ЗАПОЛНЯТЬ без полного понимания.
# С ключом рестарт бота перезапускает ВЕСЬ сервер (падают все боты).
PANEL_URL=https://control.play2go.cloud
PANEL_API_KEY=
SERVER_ID=

# === Необязательные ===
BACKUP_HOUR_UTC=4                     # час ежедневного автобэкапа
NEWS_HOUR_UTC=8                       # час новостной сводки админам
NEWS_UNTIL=2026-08-31                 # после этой даты новостной цикл остановится
BACKUP_ENV=0                          # 1 = включить .env в автобэкап (опасно)
BOTOHUB_AD_EVERY=5                    # реклама каждые N сообщений
AI_MAX_CONCURRENT=4                   # одновременных запросов к моделям
